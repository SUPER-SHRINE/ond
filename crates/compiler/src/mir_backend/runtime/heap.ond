// Included in runtime. Linker-owned heap state is passed explicitly by the backend.
// Headers contain total block bytes (multiple of four) and bit 0 = allocated.
func __ond_alloc(n:u32,base:u32,bottom:u32,state:u32)->u32 {
    if n==0 || n>4294967288 { return 0 }
    var need=((n+3)&4294967292)+4
    var cursor=*(state as *u32)
    if cursor==0 { cursor=base; *(state as *u32) = cursor }
    var at=base
    for at<cursor {
        var header=*(at as *u32)
        var size=header&4294967292
        if (header&1)==0 && size>=need {
            if size-need>=8 {
                *(at as *u32) = need|1
                *((at+need) as *u32) = size-need
            } else { *(at as *u32) = size|1 }
            return at+4
        }
        at=at+size
    }
    if cursor>bottom || need>bottom-cursor { return 0 }
    *(cursor as *u32) = need|1
    *(state as *u32) = cursor+need
    return cursor+4
}
func __ond_free(p:u32,base:u32,state:u32) {
    if p==0 { return }
    var cursor=*(state as *u32)
    var at=base
    var prev:u32
    for at<cursor {
        var header=*(at as *u32)
        var size=header&4294967292
        if at+4==p {
            *(at as *u32) = size
            var next=at+size
            if next<cursor {
                var after=*(next as *u32)
                if (after&1)==0 { size=size+(after&4294967292); *(at as *u32) = size }
            }
            if prev!=0 {
                var before=*(prev as *u32)
                if (before&1)==0 { size=size+(before&4294967292); at=prev; *(at as *u32) = size }
            }
            if at+size==cursor { *(state as *u32) = at }
            return
        }
        prev=at
        at=at+size
    }
}
func __ond_new(n:u32,base:u32,bottom:u32,state:u32)->u32 {
    var payload=n
    if payload==0 { payload=1 }
    var p=__ond_alloc(payload,base,bottom,state)
    if p==0 { return 0 }
    var bytes=p as *u8
    var i:u32
    for i<n { bytes[i]=0; i=i+1 }
    return p
}
