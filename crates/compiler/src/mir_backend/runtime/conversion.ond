// Raw conversion kinds use the low byte for bit width or fractional width.
// High byte: 0 unsigned, 1 signed, 2 floating-point, 3 fixed-point.
func __convert_scale(m:u64, power:i32, round:bool) -> u64 {
    if m == 0 { return 0 }
    if power >= 0 {
        if power >= 64 { __sf_invalid(); return 0 }
        var shift = power as u32
        var q = m << shift
        if q >> shift != m { __sf_invalid(); return 0 }
        return q
    }
    var count = (-power) as u32
    if count > 64 { return 0 }
    if count == 64 {
        if round && m > 0x8000000000000000 { return 1 }
        return 0
    }
    var q = m >> count
    if round {
        var half = 1 as u64 << (count-1)
        var tail = m & ((half << 1)-1)
        if tail > half || (tail == half && (q & 1) != 0) { q++ }
    }
    return q
}

func __convert_float(sign:bool,m:u64,power:i32,width:u32) -> u64 {
    var fraction:u32 = 23
    var bias:i32 = 127
    var magnitudeMask:u64 = 0x7fffffff
    if width == 64 { fraction = 52; bias = 1023; magnitudeMask = 0x7fffffffffffffff }
    if m == 0 { return __float_sign(sign,width-1) }
    var length:u32 = 64
    var normalized = m
    for normalized >> 63 == 0 { normalized <<= 1; length-- }
    var ext = __float_jam(normalized,60-fraction)
    var exponent = power + length as i32 - 1
    var bits = __float_pack(sign,exponent,ext,fraction,bias)
    if (bits & magnitudeMask) >> fraction == (2*bias+1) as u64 { __sf_invalid() }
    return bits
}

func __ond_convert_wide(bits:u64, source:u32, destination:u32) -> u64 {
    var category = source >> 8
    var width = source & 255
    var destCategory = destination >> 8
    var destWidth = destination & 255
    var sign = false
    var mantissa = bits
    var power:i32
    if category == 2 {
        sign = (bits >> (width-1)) != 0
        var fraction:u32 = 23
        var bias:i32 = 127
        if width == 64 { fraction = 52; bias = 1023 }
        var signMask = 1 as u64 << (width-1)
        var magnitude = bits &^ signMask
        var exponent = (magnitude >> fraction) as i32
        var unit = 1 as u64 << fraction
        mantissa = magnitude & (unit-1)
        if exponent == 2*bias+1 {
            if destCategory != 2 { __sf_invalid(); return 0 }
            if destWidth == 32 {
                if mantissa != 0 { return 0x7fc00000 }
                return __float_sign(sign,31) | 0x7f800000
            }
            if mantissa != 0 { return 0x7ff8000000000000 }
            return __float_sign(sign,63) | 0x7ff0000000000000
        }
        if exponent != 0 { mantissa |= unit } else { exponent = 1 }
        power = exponent - bias - fraction as i32
    } else {
        if category != 0 && bits >> 63 != 0 {
            sign = true
            mantissa = -bits
        }
        if category == 3 { power = -(width as i32) }
    }

    if destCategory == 2 { return __convert_float(sign,mantissa,power,destWidth) }
    var q:u64
    var limit:u64
    if destCategory == 3 {
        q = __convert_scale(mantissa,power + destWidth as i32,true)
        limit = 1 as u64 << (2 as u32 * destWidth-1)
    } else {
        q = __convert_scale(mantissa,power,false)
        if destCategory == 0 {
            var maximum:u64 = 0xffffffffffffffff
            if destWidth < 64 { maximum = (1 as u64 << destWidth)-1 }
            if (sign && q != 0) || q > maximum { __sf_invalid() }
            return q
        }
        limit = 1 as u64 << (destWidth-1)
    }
    if q > limit || (q == limit && !sign) { __sf_invalid() }
    if sign { return -q }
    return q
}
